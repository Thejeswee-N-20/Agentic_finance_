# Copy to .env and fill in. .env is gitignored.

# --- Generative (reasoning) tier: gemini | ollama ---
# Leave commented to auto-detect: gemini when GOOGLE_API_KEY is set, else ollama.
# Set explicitly to force one, e.g. to use a local model:
AGENTIC_SLM_PROVIDER=ollama
AGENTIC_GEMINI_MODEL=gemini-2.5-flash
# Local model served by Ollama. Use the project's QLoRA fine-tune once imported
# (see fine-tuned-slm/README.md):  AGENTIC_OLLAMA_MODEL=qwen2.5-3b-fingpt
AGENTIC_OLLAMA_MODEL=qwen2.5:3b
# Greedy decoding (0 = deterministic, reproducible signals) is the default.
# AGENTIC_OLLAMA_TEMPERATURE=0
# OLLAMA_BASE_URL=http://localhost:11434
GOOGLE_API_KEY=

# --- Sentiment backend: heuristic | gemini ---
AGENTIC_SENTIMENT_BACKEND=heuristic

# --- News provider: tavily | yahoo ---
#
#   yahoo   free, no account, no key. Recent headlines only.
#   tavily  needs a free API key; adds date-range search, which is what makes
#           historical backtests point-in-time (leakage-safe).
#
# NO KEY? Use yahoo - it works out of the box:
AGENTIC_NEWS_PROVIDER=yahoo
#
# HAVE A TAVILY KEY? Comment the line above, uncomment both lines below:
# AGENTIC_NEWS_PROVIDER=tavily
# TAVILY_NEWS_API_KEY=tvly-your-key-here

# --- RAG over SEC filings (leakage-safe excerpts for the news agent) ---
# On by default; set off to skip filing retrieval entirely.
# AGENTIC_RAG=on
# Local vector-index directory (created on first ingest).
# AGENTIC_RAG_DIR=data/rag_index
# Embedder: dependency-free hashing (default) | st (sentence-transformers,
# requires `pip install -e ".[rag]"`).
# AGENTIC_RAG_EMBEDDER=hash
